{
  "name": "cat-agents",
  "version": "1.0.2",
  "description": "Live visualization of locally running Claude Code and Codex agents as an isometric voxel office full of cats",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agents",
    "visualization",
    "cats"
  ],
  "license": "MIT",
  "author": "Stanislav Horvath <standa@tonakodi.cz>",
  "homepage": "https://github.com/standahorvath/cat-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standahorvath/cat-agents.git"
  },
  "bugs": {
    "url": "https://github.com/standahorvath/cat-agents/issues"
  },
  "type": "module",
  "bin": {
    "cat-agents": "bin/cat-agents.js"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "docker": "docker compose up -d --build",
    "hooks:remove": "node server/hooks.js --remove",
    "test": "node --test test/*.test.js",
    "stats": "node scripts/stats.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
